# Convex CLI local deployment selection.
# `corepack pnpm convex dev` writes these to .env.local after project setup.
CONVEX_DEPLOYMENT=
CONVEX_URL=
CONVEX_SITE_URL=

# Expo public values. Keep these in artifacts/mobile/.env.local for local Expo runs.
EXPO_PUBLIC_CONVEX_URL=
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
EXPO_PUBLIC_ADMIN_WHATSAPP_NUMBER=917988810502

# Convex dashboard environment variables.
# Set with:
# corepack pnpm convex env set NAME 'value'
CLERK_JWT_ISSUER_DOMAIN=https://your-clerk-instance.clerk.accounts.dev
ADMIN_EMAILS=founder@example.com

# Slack review flow.
# Create a Slack app, add the bot to your review/payment channels, and set these in Convex env.
SLACK_BOT_TOKEN=xoxb-your-token
SLACK_SIGNING_SECRET=your-signing-secret
SLACK_REVIEW_CHANNEL_ID=C0123456789
SLACK_PAYMENT_CHANNEL_ID=C0123456789

# Email notifications.
# Resend docs: https://resend.com/docs/api-reference/emails/send-email
RESEND_API_KEY=re_your_key
EMAIL_FROM="Pact Raven <notifications@pactraven.com>"
