{
  "installCommand": "corepack pnpm install --frozen-lockfile --ignore-scripts",
  "buildCommand": "EXPO_PUBLIC_DOMAIN=app.pactraven.com corepack pnpm --filter @workspace/mobile run build:web",
  "outputDirectory": "artifacts/mobile/dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
